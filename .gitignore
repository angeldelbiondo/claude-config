# Credenciales — NUNCA commitear
.credentials.json
mcp-needs-auth-cache.json

# Datos de sesión — efímeros, no útiles para restaurar.
# Excepción: la memoria de Claude por proyecto (projects/<proyecto>/memory/) sí se versiona.
projects/**
!projects/*/
!projects/*/memory/
!projects/*/memory/**
tasks/
telemetry/

# Skills — todas se versionan acá, salvo los dos forks de GitHub, que restore.ps1 clona
# y parchea (skill-patches/). obsidian-second-brain además trae un .venv de 143 MB.
skills/obsidian-second-brain/
skills/marketing-research/

# Plugins del marketplace — se reinstalan desde la UI de Claude Code
plugins/

# Generados o efímeros
cache/
debug/
state/
dev-mods/
hooks/logs/
settings.json.bak*
backups/
sessions/
shell-snapshots/
history.jsonl
.last-cleanup

# Estado efímero de sesión
plans/
.ponytail-active

# Estado local de la app y caché de Python — no sirven para restaurar
.claude.json
chrome/
file-history/
security/
__pycache__/
