{
  "env": {
    "OBSIDIAN_VAULT_PATH": "C:\\Users\\angel\\Documents\\Obsidian Vault"
  },
  "model": "sonnet",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "& \"C:\\Users\\angel\\.claude\\hooks\\ponytail-precommit.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "Ponytail pre-commit check"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\angel\\.claude\\hooks\\red-sistema-guard.py\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "Revisando si el comando toca red o sistema"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "& \"C:\\Users\\angel\\.claude\\hooks\\vault-contexto.ps1\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "Cargando CRITICAL_FACTS del vault"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\angel\\.claude\\hooks\\vault-autoconsulta.py\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "Consultando el vault"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\angel\\.claude\\hooks\\firmas-canario.py\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "Revisando firmas y canario"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "powershell -ExecutionPolicy Bypass -File \"C:\\Users\\angel\\.claude\\plugins\\cache\\ponytail\\ponytail\\4.6.0\\hooks\\ponytail-statusline.ps1\""
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "claude-video-vision@claude-video-vision": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gsap-skills@gsap-skills": true,
    "burn-meter@claude-code-mods": true,
    "agent-narrator@claude-code-mods": true,
    "chat-bubbles@claude-chat-bubbles": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-video-vision": {
      "source": {
        "source": "git",
        "url": "https://github.com/jordanrendric/claude-video-vision.git"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/skills.git"
      }
    },
    "gsap-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/greensock/gsap-skills.git"
      }
    },
    "claude-code-mods": {
      "source": {
        "source": "github",
        "repo": "OneWave-AI/claude-code-mods"
      }
    },
    "claude-chat-bubbles": {
      "source": {
        "source": "github",
        "repo": "angeldelbiondo/claude-chat-bubbles"
      }
    }
  },
  "outputStyle": "Proactive",
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
